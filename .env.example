# Copiez ce fichier en .env.local et remplissez les valeurs.
# .env.local n'est jamais commité (voir .gitignore).

# Chaîne de connexion fournie par votre hébergeur PostgreSQL
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_DE_LA_BASE

# Mettre à false uniquement pour une base locale sans SSL
DATABASE_SSL=true
